# Copy this file to .env and replace the values before running the app.
SECRET_KEY=change-this-secret-key
WTF_CSRF_SECRET_KEY=change-this-csrf-secret-key

# Use production for Docker unless you intentionally need debugging.
FLASK_ENV=production
FLASK_DEBUG=0
PORT=5000

# Optional: create first admin from environment when running src/create_db.py
ADMIN_USERNAME=adminuser
ADMIN_PASSWORD=change-this-strong-password

# Optional custom database path.
# Leave this commented for the default stable path: /app/instance/student_management.db in Docker.
# DATABASE_URL=sqlite:////app/instance/student_management.db
